# LS_Warden_330_SSF.filter - rarity-first SSF campaign / mapping filter
# Revision: Viscera league-drop highlighting, 2026-11-15. Normal PoE 1, not Ruthless.
# NORMAL = WHITE | MAGIC = BLUE | RARE = YELLOW | UNIQUE = ORANGE
# BORDERS: cyan claw, purple links, pink 5/6L, green compact RGB recipe.
# VISCERA: bright pink label/border, dark background, pink beam/kite and alert.
# First four palette rules Continue; equipment rules preserve their text colors.
# All equipment remains visible through AREA level 32 (Acts 1-3).
# All rares/uniques and unmatched non-equipment stay visible at every level.
# No custom sound files or external filter imports required.
# Copy this file to the game's filter folder; select it and Reload in Options.
# Source syntax: https://www.pathofexile.com/item-filter/about

# RARITY PALETTE: Normal (preserved by equipment rules)
Show
    Rarity Normal
    SetTextColor 230 230 230 255
    SetBorderColor 90 90 90 255
    SetBackgroundColor 8 10 14 235
    SetFontSize 32
    Continue

# RARITY PALETTE: Magic (preserved by equipment rules)
Show
    Rarity Magic
    SetTextColor 136 136 255 255
    SetBorderColor 69 69 140 255
    SetBackgroundColor 10 12 32 245
    SetFontSize 33
    Continue

# RARITY PALETTE: Rare (preserved by equipment rules)
Show
    Rarity Rare
    SetTextColor 255 255 85 255
    SetBorderColor 232 189 48 255
    SetBackgroundColor 48 38 0 250
    SetFontSize 39
    Continue

# RARITY PALETTE: Unique (preserved by equipment rules)
Show
    Rarity Unique
    SetTextColor 255 140 40 255
    SetBorderColor 255 140 40 255
    SetBackgroundColor 48 19 6 250
    SetFontSize 42
    Continue

# VISCERA: ALL WICKERMAN BODY PARTS, EVERY TIER AND AREA LEVEL
# Match the item class, not equipment slots or individual body-part names.
# Terminal rule: later equipment/rarity rules must not override this style.
Show
    Class == "Viscera"
    SetTextColor 255 130 220 255
    SetBorderColor 255 40 170 255
    SetBackgroundColor 40 5 25 255
    SetFontSize 45
    PlayAlertSound 4 250
    PlayEffect Pink
    MinimapIcon 0 Pink Kite

# QUEST AND LABYRINTH ITEMS
Show
    Class "Quest" "Labyrinth" "Pantheon"
    SetTextColor 80 255 140 255
    SetBorderColor 80 255 140 255
    SetBackgroundColor 8 35 16 255
    SetFontSize 42
    MinimapIcon 1 Green Pentagon

# TOP CURRENCY
Show
    Class "Stackable Currency"
    BaseType "Mirror of Kalandra" "Divine Orb" "Exalted Orb" "Orb of Annulment" "Sacred Orb" "Fracturing Orb" "Hinekora's Lock"
    SetTextColor 255 40 60 255
    SetBorderColor 255 40 60 255
    SetBackgroundColor 255 255 255 255
    SetFontSize 45
    PlayAlertSound 6 300
    PlayEffect Red
    MinimapIcon 0 Red Star

# UPGRADE CURRENCY
Show
    Class "Stackable Currency"
    BaseType "Chaos Orb" "Orb of Alchemy" "Orb of Binding" "Orb of Regret" "Orb of Unmaking" "Vaal Orb" "Gemcutter's Prism" "Instilling Orb" "Enkindling Orb" "Orb of Scouring" "Regal Orb" "Cartographer's Chisel" "Glassblower's Bauble" "Orb of Horizons" "Ancient Orb"
    SetTextColor 255 225 130 255
    SetBorderColor 220 165 45 255
    SetBackgroundColor 45 28 6 250
    SetFontSize 40
    PlayAlertSound 2 180
    MinimapIcon 1 Yellow Circle

# CRAFTING AND LEAGUE CURRENCY
Show
    Class "Stackable Currency"
    BaseType "Essence" "Remnant of Corruption" "Fossil" "Resonator" "Oil" "Catalyst" "Eldritch" "Lifeforce" "Exotic Coinage" "Scrap Metal" "Astragali" "Burial Medallion"
    SetTextColor 90 230 235 255
    SetBorderColor 40 170 190 255
    SetBackgroundColor 6 30 36 250
    SetFontSize 39
    MinimapIcon 1 Cyan Circle

# SCROLLS: SMALL AND QUIET
Show
    Class "Stackable Currency"
    BaseType "Scroll of Wisdom" "Portal Scroll"
    SetTextColor 180 165 140 255
    SetBorderColor 70 60 45 200
    SetBackgroundColor 12 10 8 220
    SetFontSize 30

# EVERY OTHER CURRENCY: NEVER HIDE
Show
    Class "Stackable Currency"
    SetTextColor 235 195 140 255
    SetBorderColor 160 105 50 255
    SetBackgroundColor 35 22 8 245
    SetFontSize 35

# QUALITY GEMS
Show
    Class "Gems"
    Quality >= 1
    SetTextColor 25 220 185 255
    SetBorderColor 25 220 185 255
    SetBackgroundColor 5 32 28 250
    SetFontSize 39
    MinimapIcon 2 Green Triangle

# ALL OTHER GEMS
Show
    Class "Gems"
    SetTextColor 30 195 165 255
    SetBorderColor 20 110 95 255
    SetBackgroundColor 4 23 22 245
    SetFontSize 35

# ALL UNIQUES: ALWAYS ORANGE
Show
    Rarity Unique
    PlayAlertSound 3 200
    PlayEffect Orange
    MinimapIcon 1 Orange Star

# 6-LINKS: PINK BORDER; KEEP RARITY TEXT
Show
    LinkedSockets >= 6
    SetBorderColor 255 60 200 255
    SetBackgroundColor 40 5 35 255
    SetFontSize 45
    PlayAlertSound 6 300
    PlayEffect Pink
    MinimapIcon 0 Pink Star

# 5-LINKS: PINK BORDER; KEEP RARITY TEXT
Show
    LinkedSockets >= 5
    SetBorderColor 255 120 220 255
    SetBackgroundColor 30 8 30 255
    SetFontSize 43
    PlayAlertSound 1 220
    PlayEffect Pink
    MinimapIcon 1 Pink Star

# MAPS, FRAGMENTS, SCARABS AND KEYS
Show
    Class "Maps" "Map Fragments" "Misc Map Items" "Vault Keys"
    SetTextColor 255 255 255 255
    SetBorderColor 240 190 70 255
    SetBackgroundColor 40 18 60 250
    SetFontSize 41
    PlayAlertSound 5 180
    MinimapIcon 1 Yellow Square

# DIVINATION CARDS
Show
    Class "Divination Cards"
    SetTextColor 100 215 255 255
    SetBorderColor 30 150 230 255
    SetBackgroundColor 8 20 45 245
    SetFontSize 38
    MinimapIcon 2 Cyan Triangle

# TINCTURES: GREEN BORDER, KEEP RARITY TEXT
Show
    Class "Tinctures"
    SetBorderColor 55 215 150 255
    SetBackgroundColor 5 32 23 250
    SetFontSize 38
    MinimapIcon 2 Green Hexagon

# UTILITY FLASKS: GREEN BORDER, KEEP RARITY TEXT
Show
    Class "Utility Flasks"
    SetBorderColor 50 160 110 255
    SetBackgroundColor 5 23 18 245
    SetFontSize 35

# LIFE AND MANA FLASKS: KEEP THROUGH EARLY MAPS
Show
    Class "Life Flasks" "Mana Flasks"
    AreaLevel <= 75
    SetBorderColor 80 130 140 255
    SetFontSize 34

# RARE CLAWS: YELLOW TEXT WITH CYAN BORDER
Show
    Rarity Rare
    Class "Claws"
    SetBorderColor 40 220 255 255
    SetFontSize 41
    MinimapIcon 2 Yellow Diamond


# 6-SOCKET RECIPE: BLUE BORDER; KEEP RARITY TEXT
Show
    Sockets >= 6
    SetBorderColor 80 170 230 255
    SetFontSize 39
    MinimapIcon 2 Blue Square

# CAMPAIGN 4-LINK: PURPLE BORDER; KEEP RARITY TEXT
Show
    Rarity <= Rare
    LinkedSockets >= 4
    AreaLevel <= 75
    SetBorderColor 192 132 252 255
    SetBackgroundColor 24 10 36 245
    SetFontSize 39
    MinimapIcon 2 Purple Square

# EARLY 3-LINK: PURPLE BORDER; KEEP RARITY TEXT
Show
    Rarity <= Rare
    LinkedSockets >= 3
    AreaLevel <= 32
    SetBorderColor 150 95 205 255
    SetFontSize 36

# OTHER RARE EQUIPMENT AND JEWELS: ALWAYS YELLOW
Show
    Rarity Rare
    Class "Claws" "Rings" "Amulets" "Belts" "Jewels" "Boots" "Gloves" "Helmets" "Body Armours" "Shields" "Swords" "Axes" "Maces" "Staves" "Wands" "Daggers" "Sceptres" "Bows" "Quivers" "Fishing Rods" "Warstaves" "Rune Daggers"

# HIGH LEVEL CLAW CRAFTING BASE: CYAN BORDER
Show
    Rarity <= Magic
    Class "Claws"
    BaseType "Imperial Claw" "Gemini Claw" "Noble Claw"
    ItemLevel >= 73
    SetBorderColor 40 220 255 255
    SetFontSize 39
    MinimapIcon 2 Cyan Diamond

# CAMPAIGN CLAW CANDIDATES: CYAN BORDER
Show
    Rarity <= Magic
    Class "Claws"
    AreaLevel <= 67
    SetBorderColor 40 180 220 255
    SetFontSize 35

# COMPACT RGB CHROMATIC RECIPE: GREEN BORDER
Show
    Rarity <= Magic
    SocketGroup RGB
    Width <= 2
    Height <= 2
    SetBorderColor 65 180 105 255
    SetFontSize 33

# CAMPAIGN JEWELLERY AND BELTS: KEEP RARITY TEXT
Show
    Rarity <= Magic
    Class "Rings" "Amulets" "Belts"
    AreaLevel <= 67
    SetBorderColor 115 150 170 255
    SetFontSize 34

# ACTS 1-3 SAFETY NET: SHOW ALL EQUIPMENT WITH RARITY PALETTE
Show
    AreaLevel <= 32

# LATER NORMAL/MAGIC EQUIPMENT CLUTTER ONLY
Hide
    Rarity <= Magic
    Class "Boots" "Gloves" "Helmets" "Body Armours" "Shields" "Bows" "Quivers" "Swords" "Axes" "Maces" "Staves" "Wands" "Daggers" "Sceptres" "Claws" "Fishing Rods" "Warstaves" "Rune Daggers"
    SetFontSize 24

# SAFE FALLBACK: KEEP EVERY UNMATCHED ITEM VISIBLE
Show
