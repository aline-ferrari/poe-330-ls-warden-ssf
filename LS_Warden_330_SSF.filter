    SetTextColor 255 190 230 255
    SetBorderColor 255 40 170 255
    SetBackgroundColor 40 5 25 255
    SetFontSize 45
    PlayAlertSound 6 250
    PlayEffect Pink
    MinimapIcon 0 Pink Star

