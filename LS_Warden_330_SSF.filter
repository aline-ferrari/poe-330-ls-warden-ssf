    Rarity <= Magic
    Class "Claws"
    BaseType "Imperial Claw" "Gemini Claw" "Noble Claw"
    ItemLevel >= 73
    SetBorderColor 40 220 255 255
    SetFontSize 39
    MinimapIcon 2 Cyan Diamond

# CAMPAIGN CLAW CANDIDATES: CYAN BORDER
Show
    Rarity <= Magic
    Class "Claws"
    AreaLevel <= 67
    SetBorderColor 40 180 220 255
    SetFontSize 35

# COMPACT RGB CHROMATIC RECIPE: GREEN BORDER
Show
    Rarity <= Magic
    SocketGroup RGB
    Width <= 2
    Height <= 2
    SetBorderColor 65 180 105 255
    SetFontSize 33

# CAMPAIGN JEWELLERY AND BELTS: KEEP RARITY TEXT
Show
    Rarity <= Magic
    Class "Rings" "Amulets" "Belts"
    AreaLevel <= 67
    SetBorderColor 115 150 170 255
    SetFontSize 34

# ACTS 1-3 SAFETY NET: SHOW ALL EQUIPMENT WITH RARITY PALETTE
Show
    AreaLevel <= 32

# LATER NORMAL/MAGIC EQUIPMENT CLUTTER ONLY
Hide
    Rarity <= Magic
    Class "Boots" "Gloves" "Helmets" "Body Armours" "Shields" "Bows" "Quivers" "Swords" "Axes" "Maces" "Staves" "Wands" "Daggers" "Sceptres" "Claws" "Fishing Rods" "Warstaves" "Rune Daggers"
    SetFontSize 24

# SAFE FALLBACK: KEEP EVERY UNMATCHED ITEM VISIBLE
Show
